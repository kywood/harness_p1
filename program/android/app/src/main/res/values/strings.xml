    <!-- Usage guide sheet (design/specs/usage-guide.md 2절) -->
    <string name="action_usage_guide">Usage guide</string>
    <string name="action_confirm">OK</string>
    <string name="guide_rights_body">PiecePlay doesn\'t provide or find content. You choose the links you play, and you\'re responsible for any use that infringes copyright.</string>
    <string name="guide_what_title">Only the video and its subtitles</string>
    <string name="guide_what_body">Enter a magnet link or a .torrent file address, and PiecePlay downloads the beginning first so you can start watching before it finishes. It downloads only the largest video file in the torrent and that video\'s subtitle files, and skips the rest.</string>
    <string name="guide_upload_title">No uploading</string>
    <string name="guide_upload_body">PiecePlay only downloads and doesn\'t upload to others. It disconnects as soon as a download finishes. Because of how torrents work, though, connected peers can see this device\'s IP address.</string>
    <string name="guide_storage_title">Stored only on this device</string>
    <string name="guide_storage_body">Downloaded videos and your Playlist are stored only on this device and are never sent anywhere. Your Playlist and resume data are kept encrypted. Everything is deleted when you delete it in Stored files or uninstall the app.</string>
    <string name="guide_data_title">Uses a lot of data</string>
    <string name="guide_data_body">Playing uses as much data as the video\'s size. Mobile data charges may apply, so we recommend turning on \"Wi-Fi only\" in Settings.</string>
    <string name="guide_ads_title">Ads</string>
    <string name="guide_ads_body">Banner ads appear on the home screen and in your Playlist, and a full-screen ad sometimes appears after you finish watching. No ads appear during playback.</string>

